# Only needed to preview the site on your own computer:
#   bundle install
#   bundle exec jekyll serve
source "https://rubygems.org"

gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

gem "tzinfo-data"   # Windows has no built-in timezone database
gem "bigdecimal"    # no longer shipped with Ruby itself
gem "logger"